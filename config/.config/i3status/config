# i3status configuration file — stow-managed (dotfiles/config/.config/i3status/config).
# Overrides the system-wide /etc/i3status.conf.
#
# Icons are Nerd Font glyphs from the Font Awesome 4 range (U+F000-U+F2E0),
# which is stable across Nerd Fonts releases. They require ttf-nerd-fonts-symbols
# (installed by setup-03-devtools); without it every icon renders as a box.
# The bar's font fallback chain lives in the i3 config's bar {} block.
#
# markup = pango is what lets each icon carry its own colour.

general {
        colors   = true
        markup   = pango
        interval = 5

        color_good     = "#a3be8c"
        color_degraded = "#ebcb8b"
        color_bad      = "#bf616a"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "volume master"
order += "memory"
order += "cpu_usage"
order += "cpu_temperature 0"
order += "disk /"
order += "battery all"
order += "tztime local"

wireless _first_ {
        format_up   = "<span foreground='#88c0d0'></span> %essid %quality"
        format_down = "<span foreground='#6c7a89'></span> off"
}

ethernet _first_ {
        format_up   = "<span foreground='#81a1c1'></span> %ip"
        format_down = "<span foreground='#6c7a89'></span> down"
}

volume master {
        format       = "<span foreground='#b48ead'></span> %volume"
        format_muted = "<span foreground='#6c7a89'></span> muted"
        device       = "pulse"
}

# %percentage_used keeps the reading meaningful on a 32 GiB machine, where a
# bare "7.3 GiB" says little on its own.
memory {
        format             = "<span foreground='#a3be8c'></span> %used (%percentage_used)"
        format_degraded    = "<span foreground='#a3be8c'></span> LOW %available"
        threshold_degraded = "15%"
        threshold_critical = "5%"
}

cpu_usage {
        format             = "<span foreground='#ebcb8b'></span> %usage"
        degraded_threshold = 70
        max_threshold      = 90
}

# No explicit path on purpose: i3status globs
# /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input by default, which
# survives the hwmon renumbering that happens across reboots.
cpu_temperature 0 {
        format        = "<span foreground='#d08770'></span> %degrees°C"
        max_threshold = 85
}

disk "/" {
        format         = "<span foreground='#81a1c1'></span> %avail"
        low_threshold  = 10
        threshold_type = percentage_free
}

# "battery all" aggregates every /sys/class/power_supply/BAT* device, so this
# works whether the firmware names the pack BAT0 or BAT1 (this Predator reports
# BAT1). last_full_capacity measures against what the pack currently charges to
# rather than its factory design capacity, so a worn battery still reads full
# when it actually is.
battery all {
        format                   = "%status %percentage %remaining"
        format_down              = "<span foreground='#bf616a'></span> no battery"
        status_chr               = "<span foreground='#ebcb8b'></span>"
        status_bat               = "<span foreground='#a3be8c'></span>"
        status_full              = "<span foreground='#8fbcbb'></span>"
        status_unk               = "<span foreground='#bf616a'></span>"
        low_threshold            = 20
        threshold_type           = percentage
        integer_battery_capacity = true
        last_full_capacity       = true
        hide_seconds             = true
}

tztime local {
        format = "<span foreground='#6c7a89'></span> %a %d %b  <span foreground='#8fbcbb'></span> %H:%M"
}
