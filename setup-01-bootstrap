#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG="$SCRIPT_DIR/01-bootstrap.log"
exec > >(tee -a "$LOG") 2>&1
echo "=== setup-01-bootstrap started at $(date) ==="

mapfile -t PACKAGES < <(cat <<'EOF'
git
base-devel
openssh
man-db
man-pages
ghostty
tmux
zsh
stow
fzf
ripgrep
bat
fd
unzip
neovim
tree-sitter-cli
lua
luarocks
xclip
wl-clipboard
lazygit
wget
rsync
docker
docker-compose
lazydocker
pyenv
EOF
)

mapfile -t AUR_PACKAGES < <(cat <<'EOF'
yay
slack-desktop
telegram-desktop
visual-studio-code-bin
postman-bin
EOF
)

echo
echo "The following packages will be installed:"
idx=1
for p in "${PACKAGES[@]}"; do printf "%2d) %s\n" "$idx" "$p"; ((idx++)); done
for p in "${AUR_PACKAGES[@]}"; do printf "%2d) %s (AUR)\n" "$idx" "$p"; ((idx++)); done

read -rp "Enter comma-separated indexes to SKIP (e.g. 3,7): " SKIP_INPUT
IFS=',' read -ra SKIP <<<"$SKIP_INPUT"
should_skip() { local n=$1; for s in "${SKIP[@]}"; do [[ ${s// /} == "$n" ]] && return 0; done; return 1; }

echo
SELECTED=()
for i in "${!PACKAGES[@]}"; do
  should_skip "$((i+1))" || SELECTED+=("${PACKAGES[$i]}")
done

if ((${#SELECTED[@]})); then
  echo "Installing selected packages..."
  sudo pacman -Sy --needed --noconfirm "${SELECTED[@]}"
else
  echo "All repo packages skipped."
fi

for i in "${!AUR_PACKAGES[@]}"; do
  idx=$(( ${#PACKAGES[@]} + i + 1 ))
  should_skip "$idx" && continue
  PKG="${AUR_PACKAGES[$i]}"
  case "$PKG" in
    yay)
      command -v yay >/dev/null && continue
      echo "Bootstrapping yay..."
      tmp=$(mktemp -d)
      git clone https://aur.archlinux.org/yay.git "$tmp/yay"
      pushd "$tmp/yay" >/dev/null
      makepkg -si --noconfirm
      popd >/dev/null && rm -rf "$tmp"
      ;;
    *)
      yay -S --needed --noconfirm "$PKG"
      ;;
  esac
done

read -rp "Stow dotfiles from $SCRIPT_DIR? [y/N]: " DOT
if [[ $DOT =~ ^[Yy] ]]; then
  pushd "$SCRIPT_DIR" >/dev/null
  stow --adopt bash zsh config bin
  git checkout -- . 2>/dev/null || true
  popd >/dev/null
  echo "Dotfiles stowed."
fi

if [[ ! -d "$HOME/.config/tmux/plugins/tpm" ]]; then
  echo "Installing TPM..."
  git clone https://github.com/tmux-plugins/tpm "$HOME/.config/tmux/plugins/tpm"
  echo "Inside tmux press <prefix> + I to install plugins."
fi

if command -v zsh >/dev/null && [[ "${SHELL:-}" != *zsh ]]; then
  echo "Setting zsh as the default shell..."
  chsh -s "$(command -v zsh)" "$USER" || echo "WARN: chsh failed; run it manually."
fi

if command -v docker >/dev/null; then
  echo "Enabling docker service and adding $USER to docker group..."
  sudo systemctl enable --now docker.service || true
  sudo usermod -aG docker "$USER" || true
  echo "Log out and back in for docker group membership to take effect."
fi

echo "=== setup-01-bootstrap completed at $(date) ==="
