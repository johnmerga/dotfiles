#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG="$SCRIPT_DIR/03-devtools.log"
exec > >(tee -a "$LOG") 2>&1
echo "=== setup-03-devtools started at $(date) ==="

export NVM_DIR="$HOME/.nvm"
if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
fi
source "$NVM_DIR/nvm.sh"
echo "Installing Node LTS..."
nvm install --lts
nvm use --lts
node -v
npm -v

PB_REL="https://github.com/protocolbuffers/protobuf/releases"
VER="30.2"
ZIP="protoc-${VER}-linux-x86_64.zip"
if ! command -v protoc >/dev/null; then
  echo "Installing protoc ${VER}..."
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/$ZIP" "$PB_REL/download/v${VER}/${ZIP}"
  unzip -q "$tmp/$ZIP" -d "$HOME/.local"
  rm -rf "$tmp"
fi
"$HOME/.local/bin/protoc" --version || echo "Ensure \$HOME/.local/bin is on PATH (it is set in your dotfiles)."

if ! command -v starship >/dev/null; then
  echo "Installing starship..."
  curl -sS https://starship.rs/install.sh | sh -s -- --yes
fi

# Nerd Fonts: the patched JetBrains Mono for the terminal/editor, plus the
# standalone symbol font so the icons in the i3 bar (~/.config/i3status/config)
# resolve via fontconfig fallback even in apps using a different family.
FONTS=(ttf-jetbrains-mono-nerd ttf-nerd-fonts-symbols)
MISSING_FONTS=()
for f in "${FONTS[@]}"; do
  pacman -Qq "$f" >/dev/null 2>&1 || MISSING_FONTS+=("$f")
done
if ((${#MISSING_FONTS[@]})); then
  echo "Installing Nerd Fonts: ${MISSING_FONTS[*]}"
  sudo pacman -Syu --needed --noconfirm --disable-download-timeout "${MISSING_FONTS[@]}"
  fc-cache -f >/dev/null
else
  echo "Nerd Fonts already installed."
fi

echo "=== setup-03-devtools completed at $(date) ==="
