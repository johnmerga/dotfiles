#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG="$SCRIPT_DIR/03-devtools.log"
exec > >(tee -a "$LOG") 2>&1
echo "=== setup-03-devtools started at $(date) ==="

###############################################################################
# 1. Node via nvm (latest LTS)
###############################################################################
if ! command -v nvm &>/dev/null; then
  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
  # shellcheck disable=SC1090
  source "$HOME/.nvm/nvm.sh"
fi
echo "Installing Node LTS..."
nvm install --lts
nvm use --lts
node -v
npm -v

###############################################################################
# 2. Protobuf compiler (protoc)
###############################################################################
PB_REL="https://github.com/protocolbuffers/protobuf/releases"
VER="30.2"
ARCH="linux-x86_64"
ZIP="protoc-${VER}-${ARCH}.zip"
curl -LO "$PB_REL/download/v${VER}/${ZIP}"
unzip -q "$ZIP" -d "$HOME/.local"
echo 'export PATH="$PATH:$HOME/.local/bin"' >>"$HOME/.bashrc"
export PATH="$PATH:$HOME/.local/bin"
rm "$ZIP"
protoc --version

###############################################################################
# 3. Starship prompt
###############################################################################
if ! command -v starship &>/dev/null; then
  curl -sS https://starship.rs/install.sh | sh -s -- --yes
  echo "Starship installed. Add 'eval \"\$(starship init zsh)\"' to your .zshrc."
fi

echo "=== setup-03-devtools completed at $(date) ==="
